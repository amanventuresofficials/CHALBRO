{
  "name": "functions",
  "description": "Cloud Functions for Chalbro",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node --test test/errorlog.test.js",
    "test:e2e": "firebase emulators:exec --only firestore --project demo-chalbro \"node functions/test/payments.e2e.js\""
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "razorpay": "^2.9.4"
  },
  "private": true
}
