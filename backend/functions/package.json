{
  "name": "functions",
  "description": "Cloud Functions for Chalbro",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node --test test/errorlog.test.js test/payments.test.js test/payouts.test.js test/captcha.test.js",
    "add-admin": "node scripts/add_admin.js",
    "test:add-admin": "firebase emulators:exec --only auth,firestore --config ../firebase.emulators.json --project demo-chalbro \"node functions/test/add_admin.e2e.js\"",
    "test:phonelogin": "firebase emulators:exec --only firestore --project demo-chalbro \"node functions/test/phone_login.e2e.js\"",
    "test:captcha": "firebase emulators:exec --only firestore --project demo-chalbro \"node functions/test/captcha.e2e.js\"",
    "test:e2e": "firebase emulators:exec --only firestore --project demo-chalbro \"node functions/test/payments.e2e.js && node functions/test/cash_payout.e2e.js && node functions/test/migrate_id_proofs.e2e.js\""
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "razorpay": "^2.9.4"
  },
  "private": true
}
