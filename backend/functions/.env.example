# Copy this file to `.env` (never commit `.env`). Only harmless IDs go in it.
# From the Razorpay Dashboard > Settings > API Keys. Use rzp_test_ keys while testing; the id and the
# secret must be from the same mode (test with test, live with live).
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME

# Only for direct UPI payouts through RazorpayX (optional, leave empty otherwise).
RAZORPAYX_ACCOUNT_NUMBER=

# ---------------------------------------------------------------------------------------------
# SECRETS are NOT kept in this file. They live in Google Secret Manager; you type each one once:
#   firebase functions:secrets:set RAZORPAY_KEY_SECRET        (the Razorpay Key Secret)
#   firebase functions:secrets:set RAZORPAYX_WEBHOOK_SECRET   (any long random text; if you use RazorpayX
#                                                              enter the same text in its webhook)
# Do NOT add those two names to this file: Firebase refuses to deploy if a name is in both places.
# ---------------------------------------------------------------------------------------------
