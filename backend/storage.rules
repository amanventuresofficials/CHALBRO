rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Profile photos: authenticated users can read any, but only write their own (.jpg)
    match /profile_photos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && fileName == request.auth.uid + '.jpg'
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ID proofs: owner can upload and read. Admins can also read.
    match /id_proofs/{fileName} {
      allow read: if request.auth != null && (
                    fileName.matches(request.auth.uid + '\\..+') || 
                    firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
                  );
      allow write: if request.auth != null
                   && fileName.matches(request.auth.uid + '\\..+')
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Task images: authenticated users can upload and read
    match /task_images/{imageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
