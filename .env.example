# ChalBro web hand-off -- all configuration in one place.
# Copy the values to the files named below. Do NOT commit real secrets.

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND  ->  edit  frontend/config.js  on the server (no rebuild needed)
# ─────────────────────────────────────────────────────────────────────────────
# Google Maps JavaScript API key for the "Nearby" map. Optional: leave empty and
# the rest of the app works without the map. Restrict the key to your domain.
GOOGLE_MAPS_JS_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# BACKEND   ->  copy to  backend/functions/.env  before deploying functions
# ─────────────────────────────────────────────────────────────────────────────
# From the Razorpay Dashboard > Settings > API Keys. Use rzp_test_ keys while testing.
# The Key SECRET must only ever live here (server side) -- never in the frontend.
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME

# ─────────────────────────────────────────────────────────────────────────────
# FIREBASE PROJECT (already baked into the frontend build; listed for reference)
# ─────────────────────────────────────────────────────────────────────────────
# These web values are public by design (security comes from the Firebase rules
# and from restricting the API key), so they are not secrets.
FIREBASE_PROJECT_ID=chal-bro
FIREBASE_AUTH_DOMAIN=chal-bro.firebaseapp.com
FIREBASE_WEB_API_KEY=AIzaSyA68T53L1Fb2Ft_wMhT3f0UVE0gfqvzaMc
FIREBASE_STORAGE_BUCKET=chal-bro.firebasestorage.app

# Your production domain (must be added to Firebase Auth "Authorized domains"
# and to the Google OAuth web client's "Authorized JavaScript origins").
SITE_DOMAIN=https://YOUR-DOMAIN.example
